{
  "expo": {
    "name": "Bottom Time",
    "slug": "bottom-time",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bottomtime",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#ffffff",
    "_comment_owner": "When the user provides their Expo username, set `expo.owner` to it and add `https://auth.expo.io/@<owner>/bottom-time` to each provider's redirect URI list to enable the Expo Go auth proxy.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bottom-time.app",
      "usesAppleSignIn": true,
      "backgroundColor": "#ffffff"
    },
    "android": {
      "package": "com.bottomtime.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
