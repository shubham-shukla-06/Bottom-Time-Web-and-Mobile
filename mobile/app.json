{
  "expo": {
    "name": "Bottom Time",
    "slug": "bottom-time",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/app_icon_1024.png",
    "scheme": "bottomtime",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#ffffff",
    "_comment_owner": "When the user provides their Expo username, set `expo.owner` to it and add `https://auth.expo.io/@<owner>/bottom-time` to each provider's redirect URI list to enable the Expo Go auth proxy.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bottom-time.app",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "backgroundColor": "#ffffff",
      "config": {
        "googleMapsApiKey": "AIzaSyCUQeCTGwgIRDQ4hJKfeGKPLQ57YCaVpzw"
      }
    },
    "android": {
      "package": "com.bottomtime.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCUQeCTGwgIRDQ4hJKfeGKPLQ57YCaVpzw"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID to sign you in."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Bottom Time uses your location to suggest nearby dive sites and to drop a pin at your current location when logging a dive."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "99fcd0a5-2063-4250-9a17-a7bf6dda4bea"
      }
    },
    "owner": "shubshukla"
  }
}
